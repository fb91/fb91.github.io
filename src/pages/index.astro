---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SocialIcon from "../components/SocialIcon.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { profile, socials, yearsOfExperience } from "../lib/profile";
import { projects } from "../lib/projects";
import { archiveItems } from "../lib/archive";

// El índice en `archiveItems` es la posición en el visor.
const gallery = archiveItems.map((item, index) => ({ ...item, index }));
const featured = gallery.filter((item) => item.featured && item.cover);
const others = gallery.filter((item) => !(item.featured && item.cover));

const primarySocials = socials.filter((social) => social.primary);
const otherSocials = socials.filter((social) => !social.primary);
const linkedin = socials.find((social) => social.icon === "linkedin");

// Botones de contacto: WhatsApp resaltado, los demás con borde.
const pill = "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors";
const solid = `${pill} border-ink bg-ink text-paper hover:border-accent hover:bg-accent`;
const outline = `${pill} border-line bg-paper/80 text-ink-2 backdrop-blur-sm hover:border-ink hover:text-ink`;

// Todas las tarjetas comparten el mismo marco; las destacadas, más apaisadas.
const frame = "w-full overflow-hidden border border-line bg-paper-2";
const zoom = "h-full w-full object-cover object-top transition duration-500 ease-out group-hover:scale-[1.03]";
---

<Base>
  <header class="rise pt-16 pb-16 sm:pt-24 sm:pb-20">
    <h1 class="font-display text-[2.6rem] leading-[1.05] font-bold tracking-[-0.035em] sm:text-[3.75rem]">
      {profile.name}
    </h1>
    <p class="mt-3 font-display text-[1.0625rem] font-semibold text-accent sm:text-lg">{profile.title}</p>

    <ul class="mt-8 flex flex-wrap items-center gap-2.5">
      <li><WhatsAppButton class={solid} /></li>
      {
        primarySocials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer" class={outline}>
              <SocialIcon name={social.icon} />
              {social.label}
            </a>
          </li>
        ))
      }
      <li>
        <!-- Agrupadas: si no entran en la línea, bajan juntas. En el celular quedan solo con ícono. -->
        <ul class="flex items-center gap-2.5">
          {
            otherSocials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noopener noreferrer" class={`${outline} max-sm:px-2.5`}>
                  <SocialIcon name={social.icon} />
                  <span class="max-sm:sr-only">{social.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>
  </header>

  <section aria-labelledby="que-hago" class="rise pb-20 [animation-delay:80ms] sm:pb-28">
    <h2 id="que-hago" class="eyebrow">Qué hago</h2>
    <div class="mt-5 grid gap-4 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12">
      <p class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.025em] sm:text-[2rem]">
        Desarrollo de software a medida.
      </p>
      <p class="text-[1.0625rem] leading-relaxed text-ink-2 lg:pt-1">
        Soy {profile.title} y desarrollo software desde hace más de <span data-years>{yearsOfExperience()}</span>
        años. Trabajé para empresas de finanzas y seguros, y por mi cuenta en proyectos propios y de clientes. Me ocupo
        de todo el proceso: desde la idea inicial hasta la implementación y el seguimiento en producción.
      </p>
    </div>
  </section>

  <section aria-labelledby="destacados" class="rise [animation-delay:160ms]">
    <h2 id="destacados" class="eyebrow">Trabajos destacados</h2>

    <ul class="mt-6 grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-6">
      {
        projects.map((project) => (
          <li class="sm:col-span-3">
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="group block">
              <div class:list={[frame, "aspect-[16/10]"]} style={project.frame ? `background-color:${project.frame}` : undefined}>
                <Image
                  src={project.image}
                  alt={`Captura de ${project.name}`}
                  widths={[480, 720, 960, 1440]}
                  sizes="(min-width: 1024px) 28rem, (min-width: 640px) 45vw, 100vw"
                  loading="lazy"
                  class={zoom}
                />
              </div>
              <p class="eyebrow mt-4">{project.kind}</p>
              <h3 class="mt-1 font-display text-xl font-semibold tracking-[-0.01em]">{project.name}</h3>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-2">{project.note}</p>
              <span class="link-underline mt-2 inline-flex items-baseline gap-1 text-sm text-muted group-hover:text-accent">
                {project.urlLabel ?? project.url}
                <span aria-hidden="true" class="text-xs">↗</span>
              </span>
            </a>
          </li>
        ))
      }

      {
        featured.map((item) => (
          <li class="sm:col-span-2">
            <button
              type="button"
              data-open={item.index}
              data-full={item.full}
              data-title={item.title}
              class="group block w-full cursor-zoom-in text-left"
            >
              <div class:list={[frame, "aspect-[16/10]"]}>
                <Image
                  src={item.cover!}
                  alt={`Captura de ${item.title}`}
                  widths={[320, 480, 720, 900]}
                  sizes="(min-width: 1024px) 19rem, (min-width: 640px) 30vw, 100vw"
                  loading="lazy"
                  class={zoom}
                />
              </div>
              <p class="eyebrow mt-4">{item.kind}</p>
              <h3 class="mt-1 font-display text-lg font-semibold tracking-[-0.01em]">{item.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-2">{item.note}</p>
              <span class="link-underline mt-2 inline-block text-sm text-muted group-hover:text-accent">Ver el trabajo</span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="primeros" class="mt-20 sm:mt-28">
    <h2 id="primeros" class="eyebrow">Primeros trabajos</h2>
    <p class="mt-3 max-w-[40rem] text-[0.9375rem] leading-relaxed text-muted">
      Sitios que hice como freelance hace unos diez años. Se nota la época: quedan como registro de cómo empecé.
    </p>

    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-4">
      {
        others.map((item) => (
          <li>
            <button
              type="button"
              data-open={item.index}
              data-full={item.full}
              data-title={item.title}
              class="group block w-full cursor-zoom-in text-left"
            >
              <div class:list={[frame, "aspect-[4/3]"]}>
                <Image
                  src={item.thumb}
                  alt=""
                  widths={[240, 360, 480, 720]}
                  sizes="(min-width: 1024px) 13rem, (min-width: 640px) 30vw, 45vw"
                  loading="lazy"
                  class={zoom}
                />
              </div>
              {/* Una sola línea: en pantallas muy angostas baja un punto y, de última, se corta con "…". */}
              <h3 class="mt-3 truncate text-[0.975rem] leading-snug font-medium max-[359px]:text-sm" title={item.title}>
                {item.title}
              </h3>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="contacto" class="mt-24 sm:mt-32">
    <h2 id="contacto" class="eyebrow">Contacto</h2>
    <p class="mt-5 max-w-[34rem] font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.025em] sm:text-[2rem]">
      ¿Tenés un proyecto o una idea? Escribime y lo charlamos.
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-2.5">
      <WhatsAppButton class={solid} />
      {
        linkedin && (
          <a href={linkedin.url} target="_blank" rel="noopener noreferrer" class={outline}>
            <SocialIcon name={linkedin.icon} />
            {linkedin.label}
          </a>
        )
      }
    </div>
  </section>

  <dialog
    id="lightbox"
    class="m-auto w-[min(94vw,58rem)] bg-transparent p-0 backdrop:bg-ink/90 backdrop:backdrop-blur-sm"
    aria-labelledby="lightbox-title"
  >
    <div class="flex max-h-[92dvh] flex-col">
      <div class="flex items-center justify-between gap-4 pb-3 text-paper">
        <p id="lightbox-title" class="font-display text-lg font-semibold"></p>

        <div class="flex items-center gap-1.5">
          <button
            type="button"
            data-nav="-1"
            aria-label="Anterior"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/25 transition-colors hover:bg-paper hover:text-ink"
          >
            ←
          </button>
          <button
            type="button"
            data-nav="1"
            aria-label="Siguiente"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/25 transition-colors hover:bg-paper hover:text-ink"
          >
            →
          </button>
          <button
            type="button"
            data-close
            aria-label="Cerrar"
            class="ml-2 flex h-9 w-9 items-center justify-center rounded-full border border-paper/25 transition-colors hover:bg-paper hover:text-ink"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Las piezas del archivo son mockups verticales largos: se scrollean. -->
      <div id="lightbox-scroll" class="min-h-0 flex-1 overflow-y-auto overscroll-contain bg-paper">
        <img id="lightbox-img" src="" alt="" class="block w-full" />
      </div>
    </div>
  </dialog>
</Base>

<script>
  import { yearsOfExperience } from "../lib/profile";

  // Los años se recalculan al abrir la página: el sitio puede pasar meses sin volver a publicarse.
  document.querySelectorAll("[data-years]").forEach((element) => {
    element.textContent = String(yearsOfExperience());
  });

  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const image = document.querySelector<HTMLImageElement>("#lightbox-img");
  const caption = document.querySelector<HTMLParagraphElement>("#lightbox-title");
  const scroller = document.querySelector<HTMLDivElement>("#lightbox-scroll");

  // Los datos salen del propio botón: el visor no carga la lista de trabajos.
  const items = [...document.querySelectorAll<HTMLButtonElement>("[data-open]")]
    .map((button) => ({
      index: Number(button.dataset.open),
      title: button.dataset.title ?? "",
      full: button.dataset.full ?? "",
    }))
    .sort((a, b) => a.index - b.index);

  if (dialog && image && caption && items.length) {
    let current = 0;

    const show = (position: number) => {
      const item = items[position];
      if (!item) return;
      current = position;
      image.src = item.full;
      image.alt = item.title;
      caption.textContent = item.title;
      if (scroller) scroller.scrollTop = 0;
    };

    const step = (direction: number) => {
      show((current + direction + items.length) % items.length);
    };

    document.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((button) => {
      button.addEventListener("click", () => {
        // Primero se abre: con el visor cerrado (oculto), volver el scroll al inicio no tiene efecto
        // y quedaba donde lo había dejado el trabajo anterior.
        dialog.showModal();
        show(items.findIndex((item) => item.index === Number(button.dataset.open)));
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>("[data-nav]").forEach((button) => {
      button.addEventListener("click", () => step(Number(button.dataset.nav)));
    });

    dialog.querySelector<HTMLButtonElement>("[data-close]")?.addEventListener("click", () => {
      dialog.close();
    });

    // Clic en el fondo cierra.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(-1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        step(1);
      }
    });
  }
</script>
