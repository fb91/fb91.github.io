---
import Base from "../layouts/Base.astro";
import { routes } from "../i18n/ui";

const lang = "es" as const;
---

<Base lang={lang} route="home" title="404 — Fabricio Bianchi">
  <section class="rise flex flex-col items-start justify-center py-24 sm:py-32">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-4 font-serif text-[2.75rem] leading-none tracking-[-0.02em] sm:text-[3.5rem]">
      Página no encontrada
    </h1>
    <p class="mt-5 max-w-[46ch] text-[1.0625rem] text-ink-2">
      La dirección no existe o el contenido se movió.
    </p>
    <a href={routes.home[lang]} class="link-underline mt-8 inline-flex items-baseline gap-1.5">
      <span aria-hidden="true">←</span>
      Volver al inicio
    </a>
  </section>
</Base>
