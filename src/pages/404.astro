---
import Base from "../layouts/Base.astro";
import { routes } from "../lib/profile";
---

<Base title="404 — Fabricio Bianchi">
  <section class="rise flex flex-col items-start justify-center py-24 sm:py-32">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-4 font-display text-[2.5rem] leading-[1.05] font-bold tracking-[-0.035em] sm:text-[3.25rem]">
      Página no encontrada
    </h1>
    <p class="mt-5 max-w-[46ch] text-[1.0625rem] text-ink-2">
      La dirección no existe o el contenido se movió.
    </p>
    <a href={routes.home} class="link-underline mt-8 inline-flex items-baseline gap-1.5">
      <span aria-hidden="true">←</span>
      Volver al inicio
    </a>
  </section>
</Base>
