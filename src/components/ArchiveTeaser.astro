---
import type { Lang } from "../i18n/ui";
import { useTranslations, routes } from "../i18n/ui";
import { archiveItems } from "../lib/archive";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const preview = archiveItems.filter((item) => item.featured).slice(0, 5);
---

<Section label={t("archive.label")}>
  <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between sm:gap-12">
    <div class="max-w-[46ch]">
      <h3 class="font-serif text-[1.75rem] leading-tight tracking-tight">
        {t("archive.teaserTitle")}
      </h3>
      <p class="mt-3 text-[0.975rem] leading-relaxed text-ink-2">{t("archive.teaserBody")}</p>
      <a
        href={routes.archive[lang]}
        class="link-underline mt-5 inline-flex items-baseline gap-1.5 text-[0.95rem]"
      >
        {t("archive.teaserCta")}
        <span aria-hidden="true" class="text-xs text-muted">→</span>
      </a>
    </div>

    <a
      href={routes.archive[lang]}
      tabindex="-1"
      aria-hidden="true"
      class="group flex shrink-0 gap-2 sm:gap-2.5"
    >
      {
        preview.map((item, index) => (
          <img
            src={item.thumb}
            alt=""
            loading="lazy"
            decoding="async"
            width="72"
            height="72"
            class:list={[
              "h-14 w-14 border border-line object-cover grayscale transition duration-300 group-hover:grayscale-0 sm:h-[4.5rem] sm:w-[4.5rem]",
              index > 2 && "hidden sm:block",
            ]}
          />
        ))
      }
    </a>
  </div>
</Section>
