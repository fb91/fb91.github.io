---
// Fondo: una red de nodos que deriva sola y reacciona al mouse (o a los toques en el celular).
// Sin movimiento si el sistema pide menos animación o el equipo es modesto: queda el dibujo quieto.
---

<canvas id="graph-bg" aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 h-full w-full"></canvas>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; cx: number; cy: number; ox: number; oy: number };
  type Ripple = { x: number; y: number; age: number };

  const canvas = document.querySelector<HTMLCanvasElement>("#graph-bg");
  const ctx = canvas?.getContext("2d");

  /** "#rrggbb" → "r,g,b" para armar rgba(). */
  const rgb = (value: string, fallback: string) => {
    const hex = value.trim().match(/^#([0-9a-f]{6})$/i)?.[1];
    return hex ? [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(",") : fallback;
  };

  if (canvas && ctx) {
    const coarse = matchMedia("(pointer: coarse)").matches;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    const modest =
      (nav.hardwareConcurrency ?? 8) < 4 || (nav.deviceMemory ?? 8) < 4 || nav.connection?.saveData === true;

    const css = getComputedStyle(document.documentElement);
    const ink = rgb(css.getPropertyValue("--color-ink"), "23,22,19");
    const accent = rgb(css.getPropertyValue("--color-accent"), "124,74,50");

    const LINK = coarse ? 120 : 150; // largo máximo de una arista (px)
    const REACH = coarse ? 150 : 200; // alcance del puntero (px)
    const PUSH = 28; // cuánto se apartan los nodos del puntero (px)
    const SPEED = 0.016; // velocidad de crucero (px/ms)
    const LEVELS = 6; // las aristas se agrupan por intensidad: un trazo por grupo
    const RIPPLE_LIFE = 1100; // ms

    let width = 0;
    let height = 0;
    let nodes: Node[] = [];
    let ripples: Ripple[] = [];
    let cap = coarse ? 42 : 80; // baja si el equipo no da abasto
    const pointer = { x: 0, y: 0, strength: 0, target: 0 };

    const nodeCount = () => {
      const count = Math.round((width * height) / (coarse ? 13000 : 16000));
      return Math.max(Math.min(18, cap), Math.min(cap, count));
    };

    const makeNode = (): Node => {
      const angle = Math.random() * Math.PI * 2;
      const speed = SPEED * (0.4 + Math.random() * 0.6);
      const vx = Math.cos(angle) * speed;
      const vy = Math.sin(angle) * speed;
      return { x: Math.random() * width, y: Math.random() * height, vx, vy, cx: vx, cy: vy, ox: 0, oy: 0 };
    };

    const resize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h || (w === width && h === height)) return;

      // En el celular la barra del navegador cambia el alto: se reescala, no se rearma.
      if (width && height) {
        for (const node of nodes) {
          node.x *= w / width;
          node.y *= h / height;
        }
      }
      width = w;
      height = h;

      const dpr = Math.min(window.devicePixelRatio || 1, coarse ? 1.5 : 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const target = nodeCount();
      while (nodes.length < target) nodes.push(makeNode());
      if (nodes.length > target * 1.3) nodes.length = target;
    };

    const update = (dt: number) => {
      const ease = Math.min(1, dt * 0.008);
      const relax = Math.min(1, dt * 0.0025);
      pointer.strength += (pointer.target - pointer.strength) * Math.min(1, dt * 0.006);

      for (const node of nodes) {
        // Después de un toque, cada nodo vuelve de a poco a su velocidad de crucero.
        node.vx += (node.cx - node.vx) * relax;
        node.vy += (node.cy - node.vy) * relax;
        node.x += node.vx * dt;
        node.y += node.vy * dt;

        if (node.x < 0 || node.x > width) {
          node.x = Math.max(0, Math.min(width, node.x));
          node.vx *= -1;
          node.cx *= -1;
        }
        if (node.y < 0 || node.y > height) {
          node.y = Math.max(0, Math.min(height, node.y));
          node.vy *= -1;
          node.cy *= -1;
        }

        // El puntero aparta a los nodos cercanos (solo al dibujarlos: no altera el recorrido).
        let tx = 0;
        let ty = 0;
        if (pointer.strength > 0.01) {
          const dx = node.x - pointer.x;
          const dy = node.y - pointer.y;
          const d = Math.hypot(dx, dy);
          if (d > 0.5 && d < REACH) {
            const force = (1 - d / REACH) ** 2 * PUSH * pointer.strength;
            tx = (dx / d) * force;
            ty = (dy / d) * force;
          }
        }
        node.ox += (tx - node.ox) * ease;
        node.oy += (ty - node.oy) * ease;
      }

      for (const ripple of ripples) ripple.age += dt;
      ripples = ripples.filter((ripple) => ripple.age < RIPPLE_LIFE);
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      const xs = nodes.map((node) => node.x + node.ox);
      const ys = nodes.map((node) => node.y + node.oy);
      const near = (x: number, y: number) =>
        pointer.strength > 0.05 && Math.hypot(x - pointer.x, y - pointer.y) < REACH;

      const calm = Array.from({ length: LEVELS }, () => new Path2D());
      const lit = Array.from({ length: LEVELS }, () => new Path2D());

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = xs[i] - xs[j];
          if (dx > LINK || dx < -LINK) continue;
          const dy = ys[i] - ys[j];
          const d = Math.hypot(dx, dy);
          if (d > LINK) continue;
          const level = Math.min(LEVELS - 1, Math.floor((1 - d / LINK) * LEVELS));
          const path = near((xs[i] + xs[j]) / 2, (ys[i] + ys[j]) / 2) ? lit[level] : calm[level];
          path.moveTo(xs[i], ys[i]);
          path.lineTo(xs[j], ys[j]);
        }
      }

      ctx.lineWidth = 1;
      for (let level = 0; level < LEVELS; level++) {
        const weight = (level + 1) / LEVELS;
        ctx.strokeStyle = `rgba(${ink},${0.14 * weight})`;
        ctx.stroke(calm[level]);
        ctx.strokeStyle = `rgba(${accent},${(0.14 + 0.36 * pointer.strength) * weight})`;
        ctx.stroke(lit[level]);
      }

      // Aristas del puntero a los nodos que tiene cerca.
      if (pointer.strength > 0.05) {
        for (let i = 0; i < nodes.length; i++) {
          const d = Math.hypot(xs[i] - pointer.x, ys[i] - pointer.y);
          if (d > REACH) continue;
          ctx.strokeStyle = `rgba(${accent},${(1 - d / REACH) * 0.4 * pointer.strength})`;
          ctx.beginPath();
          ctx.moveTo(pointer.x, pointer.y);
          ctx.lineTo(xs[i], ys[i]);
          ctx.stroke();
        }
      }

      const dots = new Path2D();
      const hotDots = new Path2D();
      for (let i = 0; i < nodes.length; i++) {
        const path = near(xs[i], ys[i]) ? hotDots : dots;
        path.moveTo(xs[i] + 1.8, ys[i]);
        path.arc(xs[i], ys[i], 1.8, 0, Math.PI * 2);
      }
      ctx.fillStyle = `rgba(${ink},0.3)`;
      ctx.fill(dots);
      ctx.fillStyle = `rgba(${accent},0.75)`;
      ctx.fill(hotDots);

      for (const ripple of ripples) {
        const t = ripple.age / RIPPLE_LIFE;
        ctx.strokeStyle = `rgba(${accent},${0.35 * (1 - t) ** 2})`;
        ctx.beginPath();
        ctx.arc(ripple.x, ripple.y, 12 + t * (coarse ? 180 : 240), 0, Math.PI * 2);
        ctx.stroke();
      }
    };

    resize();
    draw();

    if (!reduced && !modest) {
      let frame = 0;
      let last = performance.now();
      let release = 0;

      // Si el equipo no da abasto se bajan los nodos; si aun así no alcanza, el fondo queda quieto.
      let sampled = 0;
      let elapsed = 0;
      let cuts = 0;
      const watch = (raw: number) => {
        if (raw > 250) return; // la pestaña estuvo oculta
        sampled++;
        if (sampled <= 60) return; // la carga de la página no cuenta
        elapsed += raw;
        if (sampled < 180) return;
        const average = elapsed / (sampled - 60);
        sampled = 0;
        elapsed = 0;
        if (average < 26) return;
        if (cuts < 2) {
          cuts++;
          cap = Math.max(14, Math.round(nodes.length * 0.6));
          nodes.length = cap;
        } else {
          frame = -1;
          pointer.strength = pointer.target = 0;
          ripples = [];
          draw();
        }
      };

      const loop = (now: number) => {
        const raw = now - last;
        last = now;
        update(Math.min(raw, 48));
        draw();
        watch(raw);
        if (frame !== -1) frame = requestAnimationFrame(loop);
      };
      frame = requestAnimationFrame(loop);
      const moving = () => frame !== -1;

      window.addEventListener(
        "pointermove",
        (event) => {
          // En pantallas táctiles el dedo que scrollea no debería arrastrar el grafo.
          if (event.pointerType !== "mouse") return;
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.target = 1;
        },
        { passive: true },
      );

      document.addEventListener("mouseout", (event) => {
        if (!event.relatedTarget) pointer.target = 0;
      });

      // Un clic o un toque abre una onda que empuja a los nodos.
      const burst = (x: number, y: number) => {
        if (!moving()) return;
        ripples = [...ripples.slice(-3), { x, y, age: 0 }];
        for (const node of nodes) {
          const dx = node.x - x;
          const dy = node.y - y;
          const d = Math.hypot(dx, dy);
          if (d < 1 || d > 260) continue;
          const kick = (1 - d / 260) * 0.35;
          node.vx += (dx / d) * kick;
          node.vy += (dy / d) * kick;
        }
      };

      // En el celular solo cuentan los toques: si el dedo empieza a scrollear, el navegador cancela el puntero.
      let tap: { id: number; x: number; y: number } | null = null;

      window.addEventListener(
        "pointerdown",
        (event) => {
          if (event.pointerType === "mouse") burst(event.clientX, event.clientY);
          else tap = { id: event.pointerId, x: event.clientX, y: event.clientY };
        },
        { passive: true },
      );

      window.addEventListener(
        "pointerup",
        (event) => {
          if (!tap || tap.id !== event.pointerId) return;
          const { x, y } = tap;
          tap = null;
          if (Math.hypot(event.clientX - x, event.clientY - y) > 12) return;
          burst(x, y);
          pointer.x = x;
          pointer.y = y;
          pointer.target = 1;
          clearTimeout(release);
          release = window.setTimeout(() => (pointer.target = 0), 700);
        },
        { passive: true },
      );

      window.addEventListener("pointercancel", () => (tap = null), { passive: true });
    }

    let pending = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(() => {
        resize();
        draw();
      });
    });
  }
</script>
