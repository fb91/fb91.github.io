---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { profile, socials } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line py-8 sm:mt-32">
  <div class="flex flex-col gap-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {profile.name}. {t("footer.rights")}</p>

    <ul class="flex items-center gap-5">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-accent"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
