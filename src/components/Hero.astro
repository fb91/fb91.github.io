---
import { Image } from "astro:assets";
import me from "../assets/me.jpg";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { profile, socials } from "../lib/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="rise pt-6 pb-16 sm:pt-12 sm:pb-24">
  <div class="flex flex-col-reverse gap-10 sm:flex-row sm:items-center sm:justify-between sm:gap-12">
    <div class="min-w-0">
      <!-- El nombre entra siempre en una sola línea: el cuerpo escala con el viewport. -->
      <h1
        class="font-serif leading-[1.02] tracking-[-0.02em] whitespace-nowrap"
        style="font-size: clamp(2.25rem, 9.2vw, 4.25rem)"
      >
        {profile.name}
      </h1>

      <p class="mt-5 text-lg text-ink-2 sm:text-xl">{profile.role[lang]}</p>

      <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
        <span aria-hidden="true" class="inline-block h-1 w-1 rounded-full bg-accent"></span>
        {profile.position[lang]}
        <span aria-hidden="true" class="text-line">/</span>
        {profile.location[lang]}
      </p>
    </div>

    <Image
      src={me}
      alt={profile.name}
      width={148}
      height={148}
      densities={[1, 2]}
      loading="eager"
      class="h-28 w-28 shrink-0 rounded-full object-cover ring-1 ring-line sm:h-[9.25rem] sm:w-[9.25rem]"
    />
  </div>

  <ul
    class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 sm:mt-12"
    aria-label={t("profile.elsewhere")}
  >
    {
      socials.map((social) => (
        <li>
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline group inline-flex items-baseline gap-1.5 text-[0.95rem] text-ink"
          >
            {social.label}
            <span aria-hidden="true" class="text-xs text-muted transition-colors group-hover:text-accent">
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
