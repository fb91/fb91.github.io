---
import type { Lang } from "../i18n/ui";
import { useTranslations, routes } from "../i18n/ui";
import { archiveItems } from "../lib/archive";
import ArchiveGrid from "./ArchiveGrid.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="rise pt-4 pb-16 sm:pt-8">
  <a
    href={routes.home[lang]}
    class="link-underline inline-flex items-baseline gap-1.5 text-sm text-muted"
  >
    <span aria-hidden="true">←</span>
    {t("archive.back")}
  </a>

  <h1 class="mt-8 font-serif text-[2.75rem] leading-none tracking-[-0.02em] sm:text-[3.5rem]">
    {t("archive.title")}
  </h1>

  <p class="mt-5 max-w-[56ch] text-[1.0625rem] leading-relaxed text-ink-2">
    {t("archive.intro")}
  </p>

  <p class="mt-3 text-sm text-muted">{archiveItems.length} {t("archive.count")}</p>

  <ArchiveGrid lang={lang} />
</section>
