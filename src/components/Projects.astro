---
import { Image } from "astro:assets";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { projects } from "../lib/projects";
import Section from "./Section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section label={t("projects.label")} id="proyectos">
  <p class="max-w-[54ch] text-[1.0625rem] text-muted">{t("projects.intro")}</p>

  <div class="mt-9 space-y-14 sm:mt-11 sm:space-y-16">
    {
      projects.map((project) => (
        <article>
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block"
            aria-label={`${project.name} — ${t("projects.visit")}`}
          >
            <div
              class="overflow-hidden border border-line transition-[transform,box-shadow] duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-[0_18px_40px_-24px_rgba(23,22,19,0.45)]"
              style={`background-color:${project.frame}`}
            >
              <Image
                src={project.image}
                alt={`${project.name} — ${project.domain}`}
                widths={[640, 960, 1280]}
                sizes="(min-width: 640px) 46rem, 92vw"
                loading="lazy"
                class="aspect-[16/10] w-full object-cover object-top"
              />
            </div>

            <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="font-serif text-[1.75rem] leading-tight tracking-tight transition-colors group-hover:text-accent">
                {project.name}
              </h3>
              <span class="inline-flex items-baseline gap-1.5 text-sm text-muted transition-colors group-hover:text-accent">
                {project.domain}
                <span aria-hidden="true" class="text-xs">
                  ↗
                </span>
              </span>
            </div>

            <p class="mt-2 max-w-[52ch] text-[0.975rem] leading-relaxed text-ink-2">
              {project.tagline[lang]}
            </p>
          </a>
        </article>
      ))
    }
  </div>
</Section>
